DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
PORT=

# Login sessions (REQUIRED for login to work). Generate JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_USERNAME=
# At least 12 characters. The admin dashboard is protected by this. Never commit the real value.
ADMIN_PASSWORD=

# MoneyMentor (Team 6). Development values point at the stand-in: node flaky-partner.js
PARTNER_URL=http://127.0.0.1:4000
PARTNER_X_API_KEY=dummy-key
PARTNER_CUSTOMER_TOKEN=dummy-token
PARTNER_CUSTOMER_ID=1
PARTNER_REGISTER_BOOKINGS=true

# Partner API keys (Team 8 etc.): name:key pairs, comma separated. Give each partner their own key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PARTNER_API_KEYS=team8:
# General rate limit per API key (or per IP). Defaults: 100 requests per 60000 ms.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
# Set to false to silence the per-request log line.
LOG_REQUESTS=
